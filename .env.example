# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables for production.

# Resend API key used by the contact and quote form (https://resend.com/api-keys).
# Until this is set the form tells visitors it is not connected yet and shows the phone number.
RESEND_API_KEY=

# Inbox that receives website leads.
LEAD_TO_EMAIL=bsabol22@comcast.net

# Sender address. Must be on a domain verified in Resend (for example
# website@brettsabolplumbing.com). Before the domain is verified, Resend only
# allows onboarding@resend.dev, which can deliver to the Resend account owner only.
LEAD_FROM_EMAIL="Brett Sabol Website <onboarding@resend.dev>"
